# Шаблон. Скопируй в server/.env и впиши свои ключи.
#   cp server/.env.example server/.env   (или скопируй вручную)

# SeekAI (seekai.cc) — claude-opus-4-7, claude-sonnet-5, gpt-5.*, gemini-3.*, grok
# Можно один ключ (старый формат) или пул через запятую/пробел:
# SEEKAI_API_KEY=sk-...
SEEKAI_API_KEYS=sk-key-1,sk-key-2,sk-key-3

# BluesMinds (api.bluesminds.com) — claude-haiku/sonnet, gemma/codegemma, qwen, glm, yi
BLUESMINDS_API_KEYS=sk-key-1,sk-key-2

# HCN (api.hcnsec.cn) — auto, DeepSeek, Qwen, GLM, Kimi, Step, MiniMax…
HCNSEC_API_KEYS=sk-key-1,sk-key-2

# NVIDIA NIM (integrate.api.nvidia.com) — только Nemotron
NVIDIA_API_KEYS=nvapi-key-1,nvapi-key-2

# Режим размышления у моделей NVIDIA включён по умолчанию (chat_template_kwargs).
# Выключить: NVIDIA_ENABLE_THINKING=0
# NVIDIA_ENABLE_THINKING=0

CODEROOM_GATEWAY_PORT=8787
# на VDS: 0.0.0.0 (слушать снаружи), локально: 127.0.0.1
CODEROOM_GATEWAY_HOST=0.0.0.0
# GATEWAY_ADMIN_TOKEN=длинная-случайная-строка

# ── Телеграм-бот управления ──
# Токен от @BotFather. Если задан — бот поднимется вместе со шлюзом (node server.mjs),
# либо отдельно: npm run bot
# TELEGRAM_BOT_TOKEN=123456789:AA...
# Кому можно управлять, через запятую. Свой id покажет сам бот: напиши ему /start.
# TELEGRAM_ADMIN_IDS=123456789

# ── Публичный бот выдачи ключей ──
# Один ключ на пользователя: 100k токенов / 5 часов, срок ключа 30 дней.
# Если задан, публичный бот автоматически запускается вместе с `npm start`.
TELEGRAM_PUBLIC_BOT_TOKEN=123456789:AA...

# ── История переписки ──
# Шлюз пишет в базу запрос и ответ каждого чата: видно в боте (/chats) и в админке.
# Выключить: 0
CODEROOM_LOG_CHATS=1
# Удалять записи старше N дней при старте (0 — хранить всё).
CODEROOM_CHAT_KEEP_DAYS=0
